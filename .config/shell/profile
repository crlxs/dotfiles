#!/bin/sh
. "${XDG_CONFIG_HOME:-$HOME/.config}/shell/env"

# Add the user's executables once, ahead of system directories.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
if [ -d /usr/local/go/bin ]; then
    case ":$PATH:" in
        *:/usr/local/go/bin:*) ;;
        *) export PATH="$PATH:/usr/local/go/bin" ;;
    esac
fi
export EDITOR="nvim"
export TERMINAL="st"
export TERMINAL_PROG="st"
export BROWSER="chromium"
mkdir -p -m 700 "$XDG_STATE_HOME/zsh" "$XDG_STATE_HOME/less" "$XDG_STATE_HOME/vim" \
    "$XDG_STATE_HOME/x11" "$XDG_CACHE_HOME/zsh"
