# Environment only: sourced by Zsh before login and interactive startup files.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

export ANSIBLE_HOME="$XDG_DATA_HOME/ansible"
export ANSIBLE_CONFIG="$XDG_CONFIG_HOME/ansible/ansible.cfg"
export ANSIBLE_LOCAL_TEMP="$XDG_CACHE_HOME/ansible/tmp"
export ANSIBLE_REMOTE_TEMP="$XDG_CACHE_HOME/ansible/remote"
export ANSIBLE_GALAXY_CACHE_DIR="$XDG_CACHE_HOME/ansible/galaxy"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
export NVM_DIR="${NVM_DIR:-$XDG_DATA_HOME/nvm}"
export LESSHISTFILE="$XDG_STATE_HOME/less/history"
export VIMINIT="${VIMINIT:-source $XDG_CONFIG_HOME/vim/vimrc}"
export TERMINFO="$XDG_DATA_HOME/terminfo"
export TERMINFO_DIRS="$TERMINFO:"
export XINITRC="$XDG_CONFIG_HOME/x11/xinitrc"

# Preserve an inherited authentication file used by an existing X session.
if [ -z "${XAUTHORITY:-}" ]; then
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ]; then
        export XAUTHORITY="$XDG_RUNTIME_DIR/Xauthority"
    else
        export XAUTHORITY="$XDG_STATE_HOME/x11/Xauthority"
    fi
fi
