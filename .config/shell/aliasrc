#!/bin/sh

alias ls="ls --color=auto --group-directories-first"
alias n="nvim"
alias k="kubectl"

# Dotfiles management aliases
dotfiles() {
    /usr/bin/git --git-dir="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles" --work-tree="$HOME" "$@"
}

# startx reads the exported XINITRC directly; no alias is needed.

# wget alias to get rid of ~/.wget-hsts
alias wget="wget --hsts-file="$XDG_CACHE_HOME/wget-hsts""

# history command for zsh only lists first 16 lines by default, aliasing to "history 1" so it lists all

alias history="history 1"
